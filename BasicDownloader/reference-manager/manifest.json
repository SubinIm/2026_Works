{
  "manifest_version": 3,
  "name": "Paperdesk · 논문과 기술문서",
  "version": "0.9.0",
  "description": "논문과 기술문서를 수집하고 PDF, 태그, 메모를 내 PC에서 관리합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "sidePanel"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Paperdesk에 저장",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
